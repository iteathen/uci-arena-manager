[Unit]
Description=UCI Arena Manager privileged service broker
Documentation=https://github.com/iteathen/uci-arena-manager

[Service]
Type=oneshot
ExecStart=/usr/bin/arena-broker --policy /etc/uci-arena/broker-policy.json --validate
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
