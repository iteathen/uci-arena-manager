<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
  <CPackWiXFragment Id="#PRODUCT">
    <Property Id="ARENA_DATA_ROOT" Secure="yes" />
    <Upgrade Id="143E64C2-4153-4E8B-8C93-6FB590779E9E">
      <UpgradeVersion
        Minimum="0.0.0"
        IncludeMinimum="yes"
        OnlyDetect="yes"
        Property="ARENA_USER_SCOPE_INSTALLED" />
    </Upgrade>
    <Launch
      Condition="Installed OR NOT ARENA_USER_SCOPE_INSTALLED"
      Message="UCI Arena Manager is already installed for this user. Uninstall that scope before installing for all users." />
    <SetProperty
      Id="ARENA_DATA_ROOT"
      Value="[CommonAppDataFolder]UCI Arena Manager"
      Before="CostFinalize"
      Condition="NOT ARENA_DATA_ROOT" />
  </CPackWiXFragment>
  <CPackWiXFragment Id="CM_CP_bin.arena_service.exe">
    <ServiceInstall
      Id="ArenaServiceInstall"
      Name="UCIArenaManager"
      DisplayName="UCI Arena Manager"
      Description="Local UCI engine, bot, match, and managed-service control plane"
      Type="ownProcess"
      Start="auto"
      ErrorControl="normal"
      Account="NT AUTHORITY\LocalService"
      Arguments="--windows-service --data-dir &quot;[ARENA_DATA_ROOT]&quot; --web-root &quot;[INSTALL_ROOT]share\uci-arena\web&quot;" />
    <ServiceControl
      Id="ArenaServiceControl"
      Name="UCIArenaManager"
      Start="install"
      Stop="both"
      Remove="uninstall"
      Wait="yes" />
  </CPackWiXFragment>
  <CPackWiXFragment Id="CM_CP_bin.arena.exe">
    <Environment
      Id="ArenaCliMachinePath"
      Name="PATH"
      Value="[INSTALL_ROOT]bin"
      Action="set"
      Part="last"
      Permanent="no"
      System="yes" />
  </CPackWiXFragment>
  <CPackWiXFragment Id="CM_CP_bin.uci_arena_manager.exe">
    <Shortcut
      Id="ArenaManagerStartMenuShortcut"
      Directory="ProgramMenuFolder"
      Name="UCI Arena Manager"
      Description="Open the local UCI Arena control plane"
      Advertise="yes"
      WorkingDirectory="INSTALL_ROOT"
      Icon="ProductIcon.ico" />
  </CPackWiXFragment>
</CPackWiXPatch>
