<?xml version="1.0" encoding="UTF-8"?>
<?ifndef ProductVersion ?>
  <?define ProductVersion="0.1.0" ?>
<?endif?>
<?ifndef SetupTrustArguments ?>
  <?define SetupTrustArguments="--metadata-dir &quot;[WixBundleExecutePackageCacheFolder]release\tuf&quot;" ?>
<?endif?>
<?ifndef SetupRepairArguments ?>
  <?define SetupRepairArguments="" ?>
<?endif?>
<?ifndef SetupUninstallArguments ?>
  <?define SetupUninstallArguments="" ?>
<?endif?>
<?ifndef ArenaDataRoot ?>
  <?define ArenaDataRoot="[LocalAppDataFolder]UCI Arena Manager" ?>
<?endif?>
<?ifndef ArenaInstallRoot ?>
  <?define ArenaInstallRoot="[LocalAppDataFolder]UCI Arena Manager\installed" ?>
<?endif?>
<?ifndef ArenaCacheRoot ?>
  <?define ArenaCacheRoot="[LocalAppDataFolder]UCI Arena Manager\cache" ?>
<?endif?>
<?ifndef ArenaKnowledgeRoot ?>
  <?define ArenaKnowledgeRoot="[LocalAppDataFolder]UCI Arena Manager\knowledge" ?>
<?endif?>
<?ifndef ArenaWorkspaceRoot ?>
  <?define ArenaWorkspaceRoot="[PersonalFolder]UCI Arena Workspaces" ?>
<?endif?>
<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle
    Name="UCI Arena Suite Setup (per-user)"
    Manufacturer="UCI Arena Manager contributors"
    Version="$(var.ProductVersion)"
    UpgradeCode="74279A7D-47F9-4115-85DA-7F64AC63E041">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense"
        ThemeFile="packaging/windows/SuiteTheme.xml"
        LocalizationFile="packaging/windows/SuiteTheme.wxl"
        LogoFile="packaging/icons/uci-arena-manager.png"
        LicenseUrl=""
        SuppressOptionsUI="no" />
    </BootstrapperApplication>
    <Variable Name="InstallUciArenaEngine" Type="numeric" Value="1" Persisted="yes" bal:Overridable="yes" />
    <Variable Name="InstallBookForge" Type="numeric" Value="1" Persisted="yes" bal:Overridable="yes" />
    <Variable Name="InstallEvidenceService" Type="numeric" Value="1" Persisted="yes" bal:Overridable="yes" />
    <Variable Name="InstallLichessAdapter" Type="numeric" Value="1" Persisted="yes" bal:Overridable="yes" />
    <Chain>
      <MsiPackage Id="ManagerCore" SourceFile="$(var.ManagerMsi)" Visible="no" Vital="yes">
        <MsiProperty Name="ARENA_DATA_ROOT" Value="$(var.ArenaDataRoot)" />
      </MsiPackage>
      <ExePackage
        Id="SuiteComponents"
        SourceFile="$(var.SuiteSetup)"
        InstallArguments="--install-scope per-user --bundle-owner &quot;[WixBundleProviderKey]&quot; --install-root &quot;$(var.ArenaInstallRoot)&quot; --data-root &quot;$(var.ArenaDataRoot)&quot; --cache-root &quot;$(var.ArenaCacheRoot)&quot; --workspace-root &quot;$(var.ArenaWorkspaceRoot)&quot; --knowledge-root &quot;$(var.ArenaKnowledgeRoot)&quot; --catalog &quot;[WixBundleExecutePackageCacheFolder]release\catalog.json&quot; $(var.SetupTrustArguments) $(var.SetupArguments) --bundle-feature uci_arena.engine=[InstallUciArenaEngine] --bundle-feature book_forge.service=[InstallBookForge] --bundle-feature uci_arena_evidence.service=[InstallEvidenceService] --bundle-feature lichess.adapter=[InstallLichessAdapter]"
        RepairArguments="--install-scope per-user --bundle-owner &quot;[WixBundleProviderKey]&quot; --install-root &quot;$(var.ArenaInstallRoot)&quot; --data-root &quot;$(var.ArenaDataRoot)&quot; --cache-root &quot;$(var.ArenaCacheRoot)&quot; --workspace-root &quot;$(var.ArenaWorkspaceRoot)&quot; --knowledge-root &quot;$(var.ArenaKnowledgeRoot)&quot; --catalog &quot;[WixBundleExecutePackageCacheFolder]release\catalog.json&quot; $(var.SetupTrustArguments) $(var.SetupRepairArguments) --bundle-feature uci_arena.engine=[InstallUciArenaEngine] --bundle-feature book_forge.service=[InstallBookForge] --bundle-feature uci_arena_evidence.service=[InstallEvidenceService] --bundle-feature lichess.adapter=[InstallLichessAdapter]"
        UninstallArguments="--install-scope per-user --bundle-owner &quot;[WixBundleProviderKey]&quot; --install-root &quot;$(var.ArenaInstallRoot)&quot; --data-root &quot;$(var.ArenaDataRoot)&quot; --cache-root &quot;$(var.ArenaCacheRoot)&quot; --workspace-root &quot;$(var.ArenaWorkspaceRoot)&quot; --knowledge-root &quot;$(var.ArenaKnowledgeRoot)&quot; --catalog &quot;[WixBundleExecutePackageCacheFolder]release\catalog.json&quot; $(var.SetupTrustArguments) $(var.SetupUninstallArguments)"
        DetectCondition="WixBundleInstalled"
        Protocol="none"
        PerMachine="no"
        Permanent="no"
        Vital="yes">
        <PayloadGroupRef Id="SuiteMediaPayloads" />
      </ExePackage>
    </Chain>
  </Bundle>
</Wix>
