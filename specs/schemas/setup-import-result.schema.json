{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uci-arena.example/schemas/setup-import-result.schema.json",
  "title": "arena_setup_import_result_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "kind",
    "mode",
    "state",
    "path",
    "validation"
  ],
  "properties": {
    "schema": {"const": "arena_setup_import_result_v1"},
    "schema_version": {"const": 1},
    "kind": {
      "enum": [
        "opening_book",
        "syzygy",
        "uci_engine",
        "book_forge",
        "evidence_service",
        "timing_profile",
        "lichess_single_game_profile",
        "lichess_capacity_profile",
        "lichess_transport_profile",
        "lichess_token_path"
      ]
    },
    "mode": {"enum": ["in_place_reference", "managed_copy"]},
    "state": {"enum": ["saved", "installed_managed"]},
    "path": {"type": "string", "minLength": 1},
    "validation": {"type": "object"},
    "receipt": {
      "$ref": "install-receipt.schema.json"
    }
  }
}
