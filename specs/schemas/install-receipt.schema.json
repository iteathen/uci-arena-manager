{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uci-arena.example/schemas/install-receipt.schema.json",
  "title": "arena_install_receipt_v1",
  "type": "object",
  "required": ["schema", "schema_version", "component_id", "component_version", "state", "active_root", "artifact_sha256"],
  "properties": {
    "schema": {"const": "arena_install_receipt_v1"},
    "schema_version": {"const": 1},
    "component_id": {"type": "string"},
    "component_version": {"type": "string"},
    "state": {"enum": ["installed_managed", "installed_disabled", "broken"]},
    "active_root": {"type": "string"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "installed_at": {"type": "string"},
    "bundle_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._{}-]+$"
    },
    "data_paths": {"type": "array", "items": {"type": "string"}},
    "configuration_path": {"type": "string"},
    "service_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "sha256",
        "configuration_schema",
        "status_schema"
      ],
      "properties": {
        "schema": {"const": "uci_arena_standalone_service_contract_v1"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "configuration_schema": {"type": "string", "minLength": 1},
        "status_schema": {"type": "string", "minLength": 1}
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": true,
      "required": ["installed"],
      "properties": {
        "installed": {"type": "boolean"},
        "matchesCurrentConfiguration": {"type": "boolean"}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "activated_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
