{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uci-arena.example/schemas/provider-release-result.schema.json",
  "title": "arena_provider_release_result_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "component_id", "component_version", "target_triple",
    "artifact_name", "artifact_sha256", "artifact_size_bytes",
    "component_manifest_sha256", "source_repository", "source_commit",
    "source_tree_sha256", "clean_tree", "release_authority",
    "suite_installer_authority", "workflow_identity",
    "toolchain_identity", "dependency_lock_identities", "build_flags",
    "sbom_sha256", "licenses_sha256", "tests"
  ],
  "properties": {
    "schema": {"const": "arena_provider_release_result_v1"},
    "component_id": {"type": "string"},
    "component_version": {"type": "string"},
    "target_triple": {"type": "string"},
    "artifact_name": {"type": "string"},
    "artifact_type": {"enum": ["archive", "file_set"]},
    "artifact_kind": {"enum": ["archive", "external_file_set_manifest"]},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_size_bytes": {"type": "integer", "minimum": 1},
    "file_set_file_count": {"type": "integer", "minimum": 1},
    "file_set_total_size_bytes": {"type": "integer", "minimum": 1},
    "external_file_count": {"type": "integer", "minimum": 1},
    "external_size_bytes": {"type": "integer", "minimum": 1},
    "payload_included": {"type": "boolean"},
    "component_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_repository": {"type": "string"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clean_tree": {"const": true},
    "release_authority": {"const": "provider_component_only"},
    "suite_installer_authority": {"const": "iteathen/uci-arena-manager"},
    "workflow_identity": {"type": "string"},
    "toolchain_identity": {"type": "object"},
    "dependency_lock_identities": {"type": "object"},
    "build_flags": {"type": "array", "items": {"type": "string"}},
    "sbom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "licenses_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "validation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "range_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "files", "bytes_transferred"],
          "properties": {
            "status": {"enum": ["passed", "not_requested"]},
            "files": {"type": "integer", "minimum": 0},
            "bytes_transferred": {"type": "integer", "minimum": 0}
          }
        },
        "local_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "files", "copied_bytes"],
          "properties": {
            "status": {"enum": ["passed", "not_requested"]},
            "files": {"type": "integer", "minimum": 0},
            "copied_bytes": {"const": 0}
          }
        }
      }
    }
  }
}
