{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uci-arena.example/schemas/saved-locator.schema.json",
  "title": "arena_saved_locator_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "kind",
    "mode",
    "path",
    "validation",
    "saved_at"
  ],
  "properties": {
    "schema": {"const": "arena_saved_locator_v1"},
    "schema_version": {"const": 1},
    "kind": {
      "enum": [
        "opening_book",
        "syzygy",
        "uci_engine",
        "book_forge",
        "evidence_service",
        "lichess_token_path"
      ]
    },
    "mode": {"const": "in_place_reference"},
    "path": {"type": "string", "minLength": 1},
    "validation": {"type": "object"},
    "saved_at": {"type": "string"}
  }
}
