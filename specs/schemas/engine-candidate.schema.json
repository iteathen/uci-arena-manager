{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uci-arena.example/schemas/engine-candidate.schema.json",
  "title": "arena_engine_candidate_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "candidate_id",
    "source",
    "state",
    "display_name",
    "executable",
    "working_directory",
    "arguments",
    "uci_options",
    "issues"
  ],
  "properties": {
    "schema": {"const": "arena_engine_candidate_v1"},
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "pattern": "^engcand-[0-9a-f]{16}$"},
    "source": {
      "enum": ["install_receipt", "saved_locator", "provider_manifest", "discovered"]
    },
    "state": {"enum": ["ready_to_probe", "unavailable"]},
    "display_name": {"type": "string", "minLength": 1},
    "executable": {"type": "string", "minLength": 1},
    "working_directory": {"type": "string", "minLength": 1},
    "arguments": {"type": "array", "items": {"type": "string"}},
    "uci_options": {"type": "object"},
    "component_id": {"type": "string"},
    "component_version": {"type": "string"},
    "recommended": {"type": "boolean"},
    "default_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "display_name", "input_adapter_id", "root"],
      "properties": {
        "model_id": {"type": "string"},
        "display_name": {"type": "string"},
        "input_adapter_id": {"type": "string"},
        "root": {"type": "string"}
      }
    },
    "launch_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "state", "timing_profile", "expected_runtime"],
      "properties": {
        "schema": {"const": "arena_uci_engine_launch_profile_v1"},
        "state": {"enum": ["conservative", "qualified_timing"]},
        "timing_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available"],
          "properties": {
            "available": {"type": "boolean"},
            "schema": {"type": "string"},
            "identity_sha256": {"type": "string"}
          }
        },
        "expected_runtime": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "timing_contract_version",
                "model_id",
                "model_fingerprint",
                "adapter_id",
                "provider_requested",
                "provider_effective",
                "provider_numeric_fingerprint",
                "hardware_driver_fingerprint",
                "onnx_runtime_version",
                "search_core"
              ],
              "properties": {
                "timing_contract_version": {"type": "string"},
                "model_id": {"type": "string"},
                "model_fingerprint": {"type": "string"},
                "adapter_id": {"type": "string"},
                "provider_requested": {"type": "string"},
                "provider_effective": {"type": "string"},
                "provider_numeric_fingerprint": {"type": "string"},
                "hardware_driver_fingerprint": {"type": "string"},
                "onnx_runtime_version": {"type": "string"},
                "search_core": {"type": "string"}
              }
            }
          ]
        }
      }
    },
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "detail"],
        "properties": {
          "code": {"type": "string"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
