{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uci-arena.example/schemas/install-component.schema.json",
  "title": "arena_install_component_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "component_id", "component_version", "files"],
  "properties": {
    "schema": {"const": "arena_install_component_v1"},
    "schema_version": {"const": 1},
    "component_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "component_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "target_triple": {"type": "string"},
    "display_name": {"type": "string", "minLength": 1},
    "entrypoints": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "default_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "display_name", "input_adapter_id", "root"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "input_adapter_id": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1}
      }
    },
    "discovery": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/discovery_entry"}
    },
    "manager_integration_api": {
      "$ref": "manager-service-api.schema.json"
    },
    "contract_manifest": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
      "uniqueItems": true
    },
    "startup": {"type": "object"},
    "data_paths": {"type": "array", "items": {"type": "string"}},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "discovery_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"enum": ["active_root", "entrypoint", "component_path"]},
        "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "path": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "entrypoint"}}},
          "then": {"required": ["entrypoint"]}
        },
        {
          "if": {"properties": {"source": {"const": "component_path"}}},
          "then": {"required": ["path"]}
        }
      ]
    },
    "discovery_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "locator": {"$ref": "#/$defs/discovery_locator"}
      }
    }
  }
}
