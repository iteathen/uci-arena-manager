{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uci-arena.example/schemas/suite-release-lock.schema.json",
  "title": "arena_suite_release_lock_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suite_version",
    "release_ready",
    "provider_repository",
    "managed_repository",
    "components",
    "managed_components"
  ],
  "properties": {
    "schema": {"const": "arena_suite_release_lock_v1"},
    "suite_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-.][A-Za-z0-9.-]+)?$"
    },
    "release_ready": {"type": "boolean"},
    "provider_repository": {"const": "iteathen/UCI_Arena"},
    "managed_repository": {"const": "iteathen/uci-arena-manager"},
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/providerComponent"}
    },
    "managed_components": {
      "type": "array",
      "items": {"$ref": "#/$defs/managedComponent"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "componentFields": {
      "type": "object",
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "component_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "target_triple": {
          "enum": ["windows-x86_64", "linux-x86_64", "any", "any-any"]
        },
        "artifact_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(?:\\.tar\\.gz|\\.file-set\\.json)$"
        },
        "artifact_sha256": {"$ref": "#/$defs/digest"},
        "artifact_type": {"enum": ["archive", "file_set"]},
        "file_count": {"type": "integer", "minimum": 1},
        "installed_bytes": {"type": "integer", "minimum": 0},
        "staging_bytes": {"type": "integer", "minimum": 0},
        "backup_bytes": {"type": "integer", "minimum": 0},
        "workspace_reserve_bytes": {"type": "integer", "minimum": 0},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "providerComponent": {
      "allOf": [
        {"$ref": "#/$defs/componentFields"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component_id",
            "component_version",
            "target_triple",
            "source_commit",
            "provider_release_tag",
            "artifact_name",
            "artifact_sha256",
            "provider_result_name",
            "provider_result_sha256",
            "provenance_bundle_name",
            "provenance_bundle_sha256",
            "provenance_certificate_identity",
            "provenance_oidc_issuer",
            "provenance_workflow_name",
            "provenance_workflow_ref",
            "provenance_workflow_trigger"
          ],
          "properties": {
            "component_id": true,
            "component_version": true,
            "target_triple": true,
            "artifact_name": true,
            "artifact_sha256": true,
            "artifact_type": true,
            "file_count": true,
            "installed_bytes": true,
            "staging_bytes": true,
            "backup_bytes": true,
            "workspace_reserve_bytes": true,
            "dependencies": true,
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "provider_release_tag": {
              "type": "string",
              "pattern": "^component/[A-Za-z0-9._/-]+$"
            },
            "provider_result_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+\\.provider-result\\.json$"
            },
            "provider_result_sha256": {"$ref": "#/$defs/digest"},
            "provenance_bundle_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+(?:\\.tar\\.gz|\\.file-set\\.json)\\.sigstore\\.json$"
            },
            "provenance_bundle_sha256": {"$ref": "#/$defs/digest"},
            "provenance_certificate_identity": {
              "const": "https://github.com/iteathen/UCI_Arena/.github/workflows/component-release.yml@refs/heads/main"
            },
            "provenance_oidc_issuer": {
              "const": "https://token.actions.githubusercontent.com"
            },
            "provenance_workflow_name": {
              "const": "Provider component candidate"
            },
            "provenance_workflow_ref": {
              "const": "refs/heads/main"
            },
            "provenance_workflow_trigger": {
              "const": "workflow_dispatch"
            }
          }
        }
      ]
    },
    "managedComponent": {
      "allOf": [
        {"$ref": "#/$defs/componentFields"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component_id",
            "component_version",
            "target_triple",
            "source_commit",
            "managed_release_tag",
            "artifact_name",
            "artifact_sha256",
            "artifact_size_bytes",
            "installed_bytes",
            "component_manifest_sha256",
            "licenses_sha256",
            "managed_result_name",
            "managed_result_sha256",
            "provenance_bundle_name",
            "provenance_bundle_sha256",
            "provenance_certificate_identity",
            "provenance_oidc_issuer",
            "provenance_workflow_name",
            "provenance_workflow_ref",
            "provenance_workflow_trigger"
          ],
          "properties": {
            "component_id": true,
            "component_version": true,
            "target_triple": true,
            "artifact_name": true,
            "artifact_sha256": true,
            "artifact_type": true,
            "file_count": true,
            "installed_bytes": true,
            "staging_bytes": true,
            "backup_bytes": true,
            "workspace_reserve_bytes": true,
            "dependencies": true,
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "managed_release_tag": {
              "type": "string",
              "pattern": "^managed/[A-Za-z0-9._/-]+$"
            },
            "artifact_size_bytes": {"type": "integer", "minimum": 1},
            "component_manifest_sha256": {"$ref": "#/$defs/digest"},
            "licenses_sha256": {"$ref": "#/$defs/digest"},
            "managed_result_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+\\.managed-result\\.json$"
            },
            "managed_result_sha256": {"$ref": "#/$defs/digest"},
            "provenance_bundle_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+\\.tar\\.gz\\.sigstore\\.json$"
            },
            "provenance_bundle_sha256": {"$ref": "#/$defs/digest"},
            "provenance_certificate_identity": {
              "const": "https://github.com/iteathen/uci-arena-manager/.github/workflows/managed-component-release.yml@refs/heads/main"
            },
            "provenance_oidc_issuer": {
              "const": "https://token.actions.githubusercontent.com"
            },
            "provenance_workflow_name": {
              "const": "Managed component candidate"
            },
            "provenance_workflow_ref": {
              "const": "refs/heads/main"
            },
            "provenance_workflow_trigger": {
              "const": "workflow_dispatch"
            },
            "source_offer_url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      ]
    }
  }
}
